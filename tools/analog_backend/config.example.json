{
  "target_body": "Moon",
  "geometry_baseline_m": 120,
  "sun_elevation_deg": 1.5,
  "alpha": 0.7,
  "weights": {"slope_deg": 1.5, "roughness_m": 1.0, "shadow_frac": 2.0, "t_p05": 2.0, "amp_ratio": 1.0, "ati": 1.0},
  "hard_limits": {"slope_deg": [0, 45]},
  "robustness_runs": 0,
  "top_n": 500,
  "max_critical": 300,

  "lro": {
    "ldem":          "/data/lro/LDEM_80S_20MPP_ADJ.TIF",
    "slope":         null,
    "roughness":     null,
    "illumination":  null,
    "diviner_tmin":  "/data/lro/diviner_tmin_south.tif",
    "diviner_tmax":  "/data/lro/diviner_tmax_south.tif",
    "diviner_tmean": null,
    "thermal_inertia": null,
    "aoi_radius_km": 150,
    "target_lat_max": -85,
    "albedo": 0.12
  },

  "domains": [
    {
      "name": "NLDAS",
      "bbox": [-125, 25, -67, 53],
      "grid_res_deg": 0.125,
      "noah": ["/data/nldas/noah/NLDAS_NOAH0125_H.*.nc"],
      "fora": ["/data/nldas/fora/NLDAS_FORA0125_H.*.nc"],
      "dem":  "/data/dem/conus_dem_fine.tif",
      "stations_csv": "/data/stations/conus_stations.csv"
    },
    {
      "name": "RCM_Arctic",
      "bbox": [-120, 66, -60, 83],
      "grid_res_deg": 0.1,
      "rcm": ["/data/rcm/arctic/*_sigma0.tif"],
      "rcm_is_db": false,
      "dem": "/data/dem/arctic_dem.tif",
      "thermal": [],
      "stations_csv": "/data/stations/arctic_stations.csv"
    },
    {
      "name": "RCM_Antarctic",
      "bbox": [-180, -85, 180, -65],
      "grid_res_deg": 0.25,
      "rcm": ["/data/rcm/antarctica/*_sigma0.tif"],
      "dem": "/data/dem/antarctic_dem.tif"
    }
  ]
}
